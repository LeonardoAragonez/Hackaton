{
  "name": "tractor-store-frontend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "start": "nx run-many -t serve -p shell,mfe-explore,mfe-decide,mfe-checkout --parallel=4",
    "start:shell": "nx serve shell",
    "build": "nx run-many -t build -p shell,mfe-explore,mfe-decide,mfe-checkout,ts-design-system",
    "test": "nx run-many -t test -p ts-design-system,shared-catalog",
    "test:design-system": "nx test ts-design-system",
    "test:shared": "nx test shared-catalog",
    "test:coverage": "nx run-many -t test --coverage -p ts-design-system,shared-catalog",
    "build:elements": "nx run ts-design-system:build-elements",
    "e2e": "nx e2e tractor-store-e2e",
    "lint": "nx run-many -t lint",
    "format": "prettier --write \"**/*.{ts,html,scss,json,md}\""
  },
  "dependencies": {
    "@angular/animations": "19.2.0",
    "@angular/common": "19.2.0",
    "@angular/compiler": "19.2.0",
    "@angular/core": "19.2.0",
    "@angular/elements": "19.2.0",
    "@angular/forms": "19.2.0",
    "@angular/platform-browser": "19.2.0",
    "@angular/platform-browser-dynamic": "19.2.0",
    "@angular/router": "19.2.0",
    "canvas-confetti": "^1.9.3",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.2.0",
    "@angular/cli": "19.2.0",
    "@angular/compiler-cli": "19.2.0",
    "@nx/angular": "21.4.0",
    "@nx/module-federation": "21.4.0",
    "@module-federation/enhanced": "0.9.1",
    "ts-jest": "^29.2.5",
    "ng-packagr": "^19.2.0",
    "@nx/eslint": "21.4.0",
    "@nx/eslint-plugin": "21.4.0",
    "@nx/jest": "21.4.0",
    "@nx/playwright": "21.4.0",
    "@nx/workspace": "21.4.0",
    "@playwright/test": "^1.49.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.4.2",
    "msw": "^2.7.0",
    "nx": "21.4.0",
    "postcss": "^8.5.15",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "msw": {
    "workerDirectory": ["apps/shell/public"]
  },
  "pnpm": {
    "overrides": {
      "@module-federation/enhanced": "0.9.1",
      "@module-federation/manifest": "0.9.1",
      "@module-federation/sdk": "0.9.1"
    }
  }
}
